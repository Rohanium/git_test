generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(VIEWER)
  avatarUrl     String?
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  activities       Activity[]
  assignedLeads    Lead[]          @relation("AssignedTo")
  opportunities    Opportunity[]   @relation("OwnedBy")
  quotes           Quote[]         @relation("CreatedBy")
  workOrders       WorkOrder[]     @relation("AssignedWorker")
  timeEntries      TimeEntry[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  notes            Note[]
  employee         Employee?
  managedProjects  Project[]       @relation("ProjectManager")

  @@map("users")
}

enum UserRole {
  ADMIN
  SALES
  DESIGNER
  WORKSHOP_MANAGER
  WORKSHOP_STAFF
  ACCOUNTS
  INSTALLER
  VIEWER
}

// ============================================================================
// CRM — CONTACTS & COMPANIES
// ============================================================================

model Company {
  id           String        @id @default(cuid())
  name         String
  type         CompanyType   @default(CUSTOMER)
  industry     String?
  website      String?
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postcode     String?
  country      String?       @default("NZ")
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  contacts     Contact[]
  leads        Lead[]
  opportunities Opportunity[]
  orders       Order[]
  quotes       Quote[]
  projects     Project[]
  supplierProfile Supplier?

  @@map("companies")
}

enum CompanyType {
  CUSTOMER
  SUPPLIER
  ARCHITECT
  BUILDER
  INTERIOR_DESIGNER
  SUBCONTRACTOR
  OTHER
}

model Contact {
  id           String      @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  mobile       String?
  jobTitle     String?
  isPrimary    Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  leads        Lead[]
  opportunities Opportunity[]
  activities   Activity[]
  quotes       Quote[]     @relation("QuoteContact")
  projects     Project[]   @relation("ProjectContact")

  @@map("contacts")
}

// ============================================================================
// CRM — LEADS & OPPORTUNITIES
// ============================================================================

model Lead {
  id            String      @id @default(cuid())
  title         String
  description   String?
  source        LeadSource
  status        LeadStatus  @default(NEW)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  projectType   ProjectType?
  address       String?
  city          String?
  postcode      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id])
  assignedToId  String?
  assignedTo    User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  referredById  String?     // Contact ID who referred
  opportunity   Opportunity?
  activities    Activity[]

  @@map("leads")
}

enum LeadSource {
  WEBSITE
  REFERRAL_ARCHITECT
  REFERRAL_BUILDER
  REFERRAL_CLIENT
  TRADE_SHOW
  SOCIAL_MEDIA
  WALK_IN
  PHONE
  EMAIL
  ADVERTISING
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum ProjectType {
  KITCHEN
  BATHROOM_VANITY
  WARDROBE
  LAUNDRY
  STUDY_OFFICE
  ENTERTAINMENT_UNIT
  BOOKCASE_SHELVING
  DOORS
  WINDOWS
  STAIRCASE
  CUSTOM_FURNITURE
  COMMERCIAL_FITOUT
  EXTERIOR_JOINERY
  OTHER
}

model Opportunity {
  id              String            @id @default(cuid())
  title           String
  description     String?
  stage           OpportunityStage  @default(ENQUIRY)
  estimatedValue  Decimal           @db.Decimal(12, 2)
  probability     Int               @default(10) // percentage
  projectType     ProjectType?
  expectedCloseDate DateTime?
  wonDate         DateTime?
  lostDate        DateTime?
  lostReason      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  contactId       String?
  contact         Contact?          @relation(fields: [contactId], references: [id])
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id])
  ownerId         String
  owner           User              @relation("OwnedBy", fields: [ownerId], references: [id])
  leadId          String?           @unique
  lead            Lead?             @relation(fields: [leadId], references: [id])
  quotes          Quote[]
  activities      Activity[]
  designBrief     DesignBrief?
  project         Project?

  @@map("opportunities")
}

enum OpportunityStage {
  ENQUIRY
  SITE_MEASURE
  DESIGN
  QUOTING
  NEGOTIATION
  WON
  LOST
}

// ============================================================================
// CRM — ACTIVITIES
// ============================================================================

model Activity {
  id            String        @id @default(cuid())
  type          ActivityType
  subject       String
  description   String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  durationMins  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])

  @@map("activities")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  SITE_MEASURE
  DESIGN_REVIEW
  NOTE
  TASK
  FOLLOW_UP
}

// ============================================================================
// PROJECTS — Central entity: Lead → Opportunity → Project → Jobs
// ============================================================================

model Project {
  id              String          @id @default(cuid())
  projectNumber   String          @unique
  name            String
  description     String?
  status          ProjectStatus   @default(PLANNING)
  priority        OrderPriority   @default(NORMAL)
  projectType     ProjectType?
  startDate       DateTime?
  targetDate      DateTime?
  completedDate   DateTime?
  siteAddress     String?
  siteCity        String?
  sitePostcode    String?
  siteNotes       String?
  totalBudget     Decimal?        @db.Decimal(12, 2)
  totalQuoted     Decimal         @db.Decimal(12, 2) @default(0)
  totalInvoiced   Decimal         @db.Decimal(12, 2) @default(0)
  totalPaid       Decimal         @db.Decimal(12, 2) @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  contactId       String?
  contact         Contact?        @relation("ProjectContact", fields: [contactId], references: [id])
  opportunityId   String?         @unique
  opportunity     Opportunity?    @relation(fields: [opportunityId], references: [id])
  managedById     String?
  managedBy       User?           @relation("ProjectManager", fields: [managedById], references: [id])
  jobs            Job[]           @relation("ProjectJobs")
  quotes          Quote[]         @relation("ProjectQuotes")
  invoices        Invoice[]       @relation("ProjectInvoices")
  deliveries      Delivery[]      @relation("ProjectDeliveries")
  plannedInvoices PlannedInvoice[]
  changeOrders    ChangeOrder[]   @relation("ProjectChangeOrders")
  designBrief     DesignBrief?    @relation("ProjectDesignBrief")
  cvImports       CabinetVisionImport[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  DESIGN
  QUOTING
  APPROVED
  IN_PRODUCTION
  ON_HOLD
  READY_FOR_DELIVERY
  INSTALLING
  COMPLETED
  CANCELLED
}

model PlannedInvoice {
  id              String              @id @default(cuid())
  description     String
  amount          Decimal             @db.Decimal(12, 2)
  plannedDate     DateTime
  milestone       String?             // e.g. "On order", "50% production", "On delivery", "On completion"
  status          PlannedInvoiceStatus @default(PLANNED)
  actualInvoiceId String?             // Links to real invoice when generated
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id])

  @@map("planned_invoices")
}

enum PlannedInvoiceStatus {
  PLANNED
  INVOICED
  CANCELLED
}

// ============================================================================
// QUOTING
// ============================================================================

model Quote {
  id              String        @id @default(cuid())
  quoteNumber     String        @unique
  version         Int           @default(1)
  status          QuoteStatus   @default(DRAFT)
  title           String
  description     String?
  validUntil      DateTime?
  subtotal        Decimal       @db.Decimal(12, 2) @default(0)
  taxRate         Decimal       @db.Decimal(5, 4)  @default(0.15) // 15% GST
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2) @default(0)
  discountPercent Decimal?      @db.Decimal(5, 2)
  discountAmount  Decimal?      @db.Decimal(12, 2)
  marginPercent   Decimal?      @db.Decimal(5, 2)
  notes           String?
  termsConditions String?
  approvedAt      DateTime?
  approvedBy      String?       // Customer name / signature reference
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  contactId       String?
  contact         Contact?      @relation("QuoteContact", fields: [contactId], references: [id])
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id])
  projectId       String?
  project         Project?      @relation("ProjectQuotes", fields: [projectId], references: [id])
  createdById     String
  createdBy       User          @relation("CreatedBy", fields: [createdById], references: [id])
  lineItems       QuoteLineItem[]
  versions        QuoteVersion[]
  order           Order?

  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
  REVISED
  CONVERTED
}

model QuoteLineItem {
  id              String    @id @default(cuid())
  sortOrder       Int       @default(0)
  productType     ProjectType
  description     String
  dimensions      String?   // e.g. "2400W x 900D x 720H"
  width           Decimal?  @db.Decimal(8, 2) // mm
  depth           Decimal?  @db.Decimal(8, 2) // mm
  height          Decimal?  @db.Decimal(8, 2) // mm
  quantity        Int       @default(1)
  materialCost    Decimal   @db.Decimal(12, 2) @default(0)
  labourCost      Decimal   @db.Decimal(12, 2) @default(0)
  labourHours     Decimal?  @db.Decimal(8, 2)
  finishType      String?   // Paint, stain, lacquer, raw
  hardwareCost    Decimal   @db.Decimal(12, 2) @default(0)
  unitPrice       Decimal   @db.Decimal(12, 2) @default(0)
  lineTotal       Decimal   @db.Decimal(12, 2) @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  quoteId         String
  quote           Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  materials       QuoteLineMaterial[]

  @@map("quote_line_items")
}

model QuoteLineMaterial {
  id              String    @id @default(cuid())
  description     String
  quantity        Decimal   @db.Decimal(10, 3)
  unit            String    // m2, lm, each, sheet, kg
  unitCost        Decimal   @db.Decimal(10, 2)
  totalCost       Decimal   @db.Decimal(12, 2)
  wastageFactor   Decimal   @db.Decimal(5, 3) @default(1.1) // 10% default wastage

  // Relations
  lineItemId      String
  lineItem        QuoteLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  materialId      String?
  material        Material?     @relation(fields: [materialId], references: [id])

  @@map("quote_line_materials")
}

model QuoteVersion {
  id           String   @id @default(cuid())
  version      Int
  snapshotJson Json     // Full quote snapshot at this version
  changedBy    String
  changeNotes  String?
  createdAt    DateTime @default(now())

  // Relations
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, version])
  @@map("quote_versions")
}

// ============================================================================
// DESIGN & ENGINEERING
// ============================================================================

model DesignBrief {
  id              String    @id @default(cuid())
  roomType        String?
  style           String?   // Modern, Traditional, Hamptons, Scandi, etc.
  dimensions      String?   // Room dimensions
  colourScheme    String?
  materialPrefs   String?   // Preferred timber species, finishes
  budgetRange     String?
  specialRequirements String?
  siteNotes       String?
  status          DesignStatus @default(BRIEF_RECEIVED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  opportunityId   String?   @unique
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id])
  projectId       String?   @unique
  project         Project?  @relation("ProjectDesignBrief", fields: [projectId], references: [id])
  designFiles     DesignFile[]
  boms            BillOfMaterials[]

  @@map("design_briefs")
}

enum DesignStatus {
  BRIEF_RECEIVED
  MEASURING
  DESIGNING
  REVIEW
  APPROVED
  REVISION_REQUESTED
}

model DesignFile {
  id           String        @id @default(cuid())
  fileName     String
  fileType     DesignFileType
  filePath     String        // S3/MinIO path
  fileSize     Int           // bytes
  version      Int           @default(1)
  description  String?
  uploadedAt   DateTime      @default(now())

  // Relations
  designBriefId String
  designBrief   DesignBrief  @relation(fields: [designBriefId], references: [id])

  @@map("design_files")
}

enum DesignFileType {
  CAD_2D
  CAD_3D
  RENDER
  SHOP_DRAWING
  CUT_LIST
  CNC_PROGRAM
  PHOTO
  SPECIFICATION
  OTHER
}

model BillOfMaterials {
  id           String          @id @default(cuid())
  name         String
  version      Int             @default(1)
  status       BomStatus       @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  designBriefId String
  designBrief   DesignBrief    @relation(fields: [designBriefId], references: [id])
  items         BomItem[]

  @@map("bills_of_materials")
}

enum BomStatus {
  DRAFT
  REVIEWED
  APPROVED
  RELEASED
}

model BomItem {
  id           String    @id @default(cuid())
  quantity     Decimal   @db.Decimal(10, 3)
  unit         String
  notes        String?

  // Relations
  bomId        String
  bom          BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id])

  @@map("bom_items")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(CONFIRMED)
  priority        OrderPriority @default(NORMAL)
  orderDate       DateTime      @default(now())
  requiredDate    DateTime?
  completedDate   DateTime?
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  depositRequired Decimal?      @db.Decimal(12, 2)
  depositPaid     Decimal?      @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  quoteId         String?       @unique
  quote           Quote?        @relation(fields: [quoteId], references: [id])
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  orderItems      OrderItem[]
  jobs            Job[]
  changeOrders    ChangeOrder[]
  invoices        Invoice[]
  deliveries      Delivery[]

  @@map("orders")
}

enum OrderStatus {
  CONFIRMED
  IN_PRODUCTION
  ON_HOLD
  READY_FOR_DELIVERY
  DELIVERED
  INSTALLED
  COMPLETED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model OrderItem {
  id            String      @id @default(cuid())
  sortOrder     Int         @default(0)
  description   String
  productType   ProjectType
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(12, 2)
  lineTotal     Decimal     @db.Decimal(12, 2)
  specifications Json?      // Detailed specs carried from quote
  createdAt     DateTime    @default(now())

  // Relations
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  job           Job?

  @@map("order_items")
}

model ChangeOrder {
  id            String            @id @default(cuid())
  changeNumber  String
  description   String
  reason        String
  costImpact    Decimal           @db.Decimal(12, 2) @default(0)
  timeImpact    Int?              // days
  status        ChangeOrderStatus @default(PENDING)
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id])
  projectId     String?
  project       Project?          @relation("ProjectChangeOrders", fields: [projectId], references: [id])

  @@map("change_orders")
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
  IMPLEMENTED
}

// ============================================================================
// INVENTORY & PROCUREMENT
// ============================================================================

model MaterialCategory {
  id          String             @id @default(cuid())
  name        String
  description String?
  parentId    String?
  parent      MaterialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    MaterialCategory[] @relation("CategoryTree")
  materials   Material[]

  @@map("material_categories")
}

model Material {
  id              String            @id @default(cuid())
  sku             String            @unique
  name            String
  description     String?
  unit            String            // m2, lm, each, sheet, kg, litre
  unitCost        Decimal           @db.Decimal(10, 2)
  sellPrice       Decimal?          @db.Decimal(10, 2)
  minStock        Decimal?          @db.Decimal(10, 3)
  maxStock        Decimal?          @db.Decimal(10, 3)
  reorderPoint    Decimal?          @db.Decimal(10, 3)
  reorderQty      Decimal?          @db.Decimal(10, 3)
  leadTimeDays    Int?
  isActive        Boolean           @default(true)
  specifications  Json?             // thickness, species, colour, grade, etc.
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  categoryId      String?
  category        MaterialCategory? @relation(fields: [categoryId], references: [id])
  stockItems      StockItem[]
  stockMovements  StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  bomItems        BomItem[]
  quoteLineMaterials QuoteLineMaterial[]
  materialAllocations MaterialAllocation[]
  supplierMaterials SupplierMaterial[]

  @@map("materials")
}

model StockItem {
  id           String    @id @default(cuid())
  quantity     Decimal   @db.Decimal(10, 3)
  location     String?   // Warehouse location code
  batchNumber  String?
  expiryDate   DateTime?
  costPerUnit  Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id])

  @@map("stock_items")
}

model StockMovement {
  id           String          @id @default(cuid())
  type         StockMoveType
  quantity     Decimal         @db.Decimal(10, 3)
  reference    String?         // PO number, Job number, etc.
  notes        String?
  createdAt    DateTime        @default(now())

  // Relations
  materialId   String
  material     Material        @relation(fields: [materialId], references: [id])

  @@map("stock_movements")
}

enum StockMoveType {
  RECEIPT          // Goods received from supplier
  ISSUE            // Issued to production job
  RETURN           // Returned from production
  ADJUSTMENT       // Manual stock adjustment
  TRANSFER         // Moved between locations
  WASTAGE          // Scrapped/wasted
  WRITE_OFF        // Written off
}

model MaterialAllocation {
  id           String    @id @default(cuid())
  quantity     Decimal   @db.Decimal(10, 3)
  status       AllocationStatus @default(RESERVED)
  createdAt    DateTime  @default(now())

  // Relations
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id])
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id])

  @@map("material_allocations")
}

enum AllocationStatus {
  RESERVED
  PICKED
  ISSUED
  CANCELLED
}

model Supplier {
  id              String    @id @default(cuid())
  accountNumber   String?
  paymentTerms    String?   // e.g. "30 days", "COD"
  leadTimeDays    Int?
  minOrderValue   Decimal?  @db.Decimal(10, 2)
  rating          Int?      // 1-5
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  companyId       String    @unique
  company         Company   @relation(fields: [companyId], references: [id])
  purchaseOrders  PurchaseOrder[]
  supplierMaterials SupplierMaterial[]
  supplierInvoices SupplierInvoice[]

  @@map("suppliers")
}

model SupplierMaterial {
  id              String    @id @default(cuid())
  supplierSku     String?
  unitCost        Decimal   @db.Decimal(10, 2)
  isPreferred     Boolean   @default(false)
  leadTimeDays    Int?
  moq             Decimal?  @db.Decimal(10, 3) // Minimum order quantity
  lastPriceDate   DateTime?

  // Relations
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  materialId      String
  material        Material  @relation(fields: [materialId], references: [id])

  @@unique([supplierId, materialId])
  @@map("supplier_materials")
}

model PurchaseOrder {
  id              String          @id @default(cuid())
  poNumber        String          @unique
  status          POStatus        @default(DRAFT)
  orderDate       DateTime?
  expectedDate    DateTime?
  receivedDate    DateTime?
  subtotal        Decimal         @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal         @db.Decimal(12, 2) @default(0)
  total           Decimal         @db.Decimal(12, 2) @default(0)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  lineItems       PurchaseOrderLine[]
  goodsReceipts   GoodsReceipt[]

  @@map("purchase_orders")
}

enum POStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id            String    @id @default(cuid())
  quantity      Decimal   @db.Decimal(10, 3)
  unitCost      Decimal   @db.Decimal(10, 2)
  lineTotal     Decimal   @db.Decimal(12, 2)
  receivedQty   Decimal   @db.Decimal(10, 3) @default(0)
  notes         String?

  // Relations
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id])

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String    @id @default(cuid())
  receiptNumber   String    @unique
  receivedDate    DateTime  @default(now())
  receivedBy      String
  notes           String?
  qualityStatus   QualityStatus @default(ACCEPTED)

  // Relations
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  items           GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String    @id @default(cuid())
  quantityReceived Decimal  @db.Decimal(10, 3)
  quantityRejected Decimal  @db.Decimal(10, 3) @default(0)
  rejectReason    String?

  // Relations
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

enum QualityStatus {
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  PENDING_INSPECTION
}

// ============================================================================
// PRODUCTION & WORKSHOP
// ============================================================================

model Job {
  id              String      @id @default(cuid())
  jobNumber       String      @unique
  status          JobStatus   @default(PENDING)
  priority        OrderPriority @default(NORMAL)
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  estimatedHours  Decimal?    @db.Decimal(8, 2)
  actualHours     Decimal?    @db.Decimal(8, 2)
  notes           String?

  // Pricing (at job level)
  materialCost    Decimal     @db.Decimal(12, 2) @default(0)
  labourCost      Decimal     @db.Decimal(12, 2) @default(0)
  labourHours     Decimal?    @db.Decimal(8, 2)
  hardwareCost    Decimal     @db.Decimal(12, 2) @default(0)
  otherCost       Decimal     @db.Decimal(12, 2) @default(0)
  totalCost       Decimal     @db.Decimal(12, 2) @default(0)
  marginPercent   Decimal?    @db.Decimal(5, 2)
  sellPrice       Decimal     @db.Decimal(12, 2) @default(0)

  // Scheduling (backward from install date)
  installDate         DateTime?
  materialOrderByDate DateTime?
  productionStartDate DateTime?
  materialLeadDays    Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  orderId         String?
  order           Order?      @relation(fields: [orderId], references: [id])
  projectId       String?
  project         Project?    @relation("ProjectJobs", fields: [projectId], references: [id])
  orderItemId     String?     @unique
  orderItem       OrderItem?  @relation(fields: [orderItemId], references: [id])
  operations      JobOperation[]
  materialAllocations MaterialAllocation[]
  timeEntries     TimeEntry[]
  qualityChecks   QualityCheck[]
  workOrders      WorkOrder[]
  labourBudgets   LabourBudget[]

  @@map("jobs")
}

enum JobStatus {
  PENDING
  MATERIALS_ORDERED
  MATERIALS_RECEIVED
  READY_TO_START
  IN_PROGRESS
  ON_HOLD
  QC_PENDING
  QC_PASSED
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model JobOperation {
  id              String          @id @default(cuid())
  operationType   OperationType
  sortOrder       Int             @default(0)
  status          OperationStatus @default(PENDING)
  estimatedMins   Int?
  actualMins      Int?
  notes           String?
  startedAt           DateTime?
  completedAt         DateTime?
  scheduledStartDate  DateTime?
  scheduledEndDate    DateTime?
  latestStartDate     DateTime?   // From backward scheduling

  // Relations
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workStationId   String?
  workStation     WorkStation?    @relation(fields: [workStationId], references: [id])

  @@map("job_operations")
}

enum OperationType {
  CUTTING
  CNC_MACHINING
  EDGE_BANDING
  DRILLING
  ROUTING
  SANDING
  ASSEMBLY
  FITTING_HARDWARE
  SPRAY_PREP
  SPRAY_PAINTING
  STAINING
  LACQUERING
  HAND_FINISHING
  GLAZING
  PACKING
  OTHER
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REWORK
  SKIPPED
}

model WorkStation {
  id              String    @id @default(cuid())
  name            String
  type            String    // CNC, Panel Saw, Edge Bander, Spray Booth, Assembly Bench
  location        String?
  capacity        Int?      // hours per day
  isActive        Boolean   @default(true)
  maintenanceNotes String?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?

  // Relations
  operations      JobOperation[]
  workOrders      WorkOrder[]
  bookings        WorkStationBooking[]
  capacitySlots   CapacitySlot[]

  @@map("work_stations")
}

model WorkStationBooking {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  startTime       DateTime
  endTime         DateTime
  notes           String?

  // Relations
  workStationId   String
  workStation     WorkStation @relation(fields: [workStationId], references: [id])

  @@map("work_station_bookings")
}

model WorkOrder {
  id              String          @id @default(cuid())
  workOrderNumber String          @unique
  instructions    String?
  status          OperationStatus @default(PENDING)
  scheduledDate   DateTime?
  completedDate   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  workStationId   String?
  workStation     WorkStation?    @relation(fields: [workStationId], references: [id])
  assignedToId    String?
  assignedTo      User?           @relation("AssignedWorker", fields: [assignedToId], references: [id])

  @@map("work_orders")
}

model TimeEntry {
  id              String    @id @default(cuid())
  clockIn         DateTime
  clockOut        DateTime?
  breakMins       Int       @default(0)
  totalMins       Int?
  notes           String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  jobId           String?
  job             Job?      @relation(fields: [jobId], references: [id])

  @@map("time_entries")
}

// ============================================================================
// QUALITY CONTROL
// ============================================================================

model QualityCheck {
  id              String          @id @default(cuid())
  checkType       String          // Pre-finish, Post-finish, Pre-dispatch
  status          QualityStatus   @default(PENDING_INSPECTION)
  inspectedBy     String?
  inspectedAt     DateTime?
  overallResult   QCResult?
  notes           String?
  createdAt       DateTime        @default(now())

  // Relations
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  checklistItems  QCChecklistItem[]
  defects         Defect[]

  @@map("quality_checks")
}

enum QCResult {
  PASS
  FAIL
  CONDITIONAL_PASS
}

model QCChecklistItem {
  id              String    @id @default(cuid())
  checkItem       String
  passed          Boolean?
  notes           String?

  // Relations
  qualityCheckId  String
  qualityCheck    QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@map("qc_checklist_items")
}

model Defect {
  id              String        @id @default(cuid())
  category        DefectCategory
  severity        DefectSeverity
  description     String
  resolution      String?
  resolvedAt      DateTime?
  photoUrls       String[]      // Array of S3 paths
  createdAt       DateTime      @default(now())

  // Relations
  qualityCheckId  String
  qualityCheck    QualityCheck  @relation(fields: [qualityCheckId], references: [id])

  @@map("defects")
}

enum DefectCategory {
  MATERIAL
  CUTTING
  MACHINING
  ASSEMBLY
  FINISH
  HARDWARE
  DESIGN
  OTHER
}

enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

// ============================================================================
// DELIVERY & INSTALLATION
// ============================================================================

model Delivery {
  id              String          @id @default(cuid())
  deliveryNumber  String          @unique
  status          DeliveryStatus  @default(SCHEDULED)
  scheduledDate   DateTime
  deliveredDate   DateTime?
  deliveryAddress String
  driverNotes     String?
  proofOfDelivery String?         // Signature image S3 path
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id])
  projectId       String?
  project         Project?        @relation("ProjectDeliveries", fields: [projectId], references: [id])
  installation    Installation?

  @@map("deliveries")
}

enum DeliveryStatus {
  SCHEDULED
  LOADING
  IN_TRANSIT
  DELIVERED
  FAILED
  RESCHEDULED
}

model Installation {
  id              String              @id @default(cuid())
  status          InstallationStatus  @default(SCHEDULED)
  scheduledDate   DateTime
  completedDate   DateTime?
  installerNotes  String?
  customerSignOff Boolean             @default(false)
  signOffDate     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  deliveryId      String              @unique
  delivery        Delivery            @relation(fields: [deliveryId], references: [id])
  snagItems       SnagItem[]

  @@map("installations")
}

enum InstallationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REQUIRES_RETURN_VISIT
  SIGNED_OFF
}

model SnagItem {
  id              String    @id @default(cuid())
  description     String
  severity        DefectSeverity
  status          SnagStatus @default(OPEN)
  photoUrls       String[]
  resolvedDate    DateTime?
  resolution      String?
  createdAt       DateTime  @default(now())

  // Relations
  installationId  String
  installation    Installation @relation(fields: [installationId], references: [id])

  @@map("snag_items")
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_BY_CUSTOMER
}

// ============================================================================
// FINANCE
// ============================================================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  type            InvoiceType   @default(STANDARD)
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @db.Decimal(12, 2) @default(0)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  projectId       String?
  project         Project?      @relation("ProjectInvoices", fields: [projectId], references: [id])
  lineItems       InvoiceLine[]
  payments        Payment[]

  @@map("invoices")
}

enum InvoiceType {
  DEPOSIT
  PROGRESS
  STANDARD
  FINAL
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

model InvoiceLine {
  id            String    @id @default(cuid())
  description   String
  quantity      Int       @default(1)
  unitPrice     Decimal   @db.Decimal(12, 2)
  lineTotal     Decimal   @db.Decimal(12, 2)

  // Relations
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?       // Bank reference, Stripe ID, cheque number
  paidDate      DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())

  // Relations
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHEQUE
  STRIPE
  OTHER
}

model SupplierInvoice {
  id              String              @id @default(cuid())
  invoiceNumber   String
  status          SupplierInvoiceStatus @default(RECEIVED)
  invoiceDate     DateTime
  dueDate         DateTime
  subtotal        Decimal             @db.Decimal(12, 2)
  taxAmount       Decimal             @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])

  @@map("supplier_invoices")
}

enum SupplierInvoiceStatus {
  RECEIVED
  APPROVED
  QUEUED_FOR_PAYMENT
  PAID
  DISPUTED
}

model JobCostRecord {
  id              String    @id @default(cuid())
  costType        CostType
  description     String
  amount          Decimal   @db.Decimal(12, 2)
  jobNumber       String
  createdAt       DateTime  @default(now())

  @@map("job_cost_records")
}

enum CostType {
  MATERIAL
  LABOUR
  SUBCONTRACTOR
  OVERHEAD
  DELIVERY
  OTHER
}

// ============================================================================
// HR & WORKFORCE
// ============================================================================

model Employee {
  id              String    @id @default(cuid())
  employeeNumber  String    @unique
  startDate       DateTime
  endDate         DateTime?
  position        String
  department      String?
  hourlyRate      Decimal?  @db.Decimal(8, 2)
  salaryAnnual    Decimal?  @db.Decimal(12, 2)
  emergencyContact String?
  emergencyPhone  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  skills          EmployeeSkill[]
  leaveRecords    LeaveRecord[]

  @@map("employees")
}

model EmployeeSkill {
  id              String    @id @default(cuid())
  skillName       String    // CNC Operation, Spray Painting, Edge Banding, etc.
  proficiency     Int       // 1-5
  certifiedDate   DateTime?
  expiryDate      DateTime?

  // Relations
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_skills")
}

model LeaveRecord {
  id              String      @id @default(cuid())
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  status          LeaveStatus @default(PENDING)
  notes           String?
  createdAt       DateTime    @default(now())

  // Relations
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id])

  @@map("leave_records")
}

enum LeaveType {
  ANNUAL
  SICK
  BEREAVEMENT
  PARENTAL
  UNPAID
  PUBLIC_HOLIDAY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================================
// SYSTEM — AUDIT, NOTES, NOTIFICATIONS, DOCUMENTS
// ============================================================================

model AuditLog {
  id          String    @id @default(cuid())
  entityType  String    // "Quote", "Order", "Job", etc.
  entityId    String
  action      String    // "CREATE", "UPDATE", "DELETE", "STATUS_CHANGE"
  changes     Json?     // Before/after snapshot
  ipAddress   String?
  createdAt   DateTime  @default(now())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Note {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  content     String
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("notes")
}

model Notification {
  id          String    @id @default(cuid())
  title       String
  message     String
  type        String    // "info", "warning", "action_required"
  isRead      Boolean   @default(false)
  link        String?   // URL to relevant page
  createdAt   DateTime  @default(now())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Document {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  fileName    String
  filePath    String    // S3/MinIO path
  fileSize    Int
  mimeType    String
  uploadedBy  String
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@map("documents")
}

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       Json
  description String?
  updatedAt   DateTime  @updatedAt

  @@map("settings")
}

// ============================================================================
// CABINET VISION INTEGRATION
// ============================================================================

model CabinetVisionImport {
  id              String    @id @default(cuid())
  fileName        String
  fileType        String    // "csv", "xml", "mfg"
  status          CVImportStatus @default(PENDING)
  rawData         Json?     // Parsed raw data from the file
  summary         Json?     // Extracted summary (total hours, materials, etc.)
  errorLog        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
  labourBudgets   LabourBudget[]

  @@map("cabinet_vision_imports")
}

enum CVImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model LabourBudget {
  id              String        @id @default(cuid())
  operationType   OperationType
  estimatedHours  Decimal       @db.Decimal(8, 2)
  complexity      String?       // "simple", "standard", "complex"
  partCount       Int?          // Number of parts for this operation
  notes           String?
  createdAt       DateTime      @default(now())

  // Relations
  cvImportId      String?
  cvImport        CabinetVisionImport? @relation(fields: [cvImportId], references: [id])
  jobId           String?
  job             Job?          @relation(fields: [jobId], references: [id])

  @@map("labour_budgets")
}

// ============================================================================
// CAPACITY PLANNING
// ============================================================================

model CapacitySlot {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  availableHours  Decimal   @db.Decimal(8, 2)
  bookedHours     Decimal   @db.Decimal(8, 2) @default(0)
  notes           String?

  // Relations
  workStationId   String
  workStation     WorkStation @relation(fields: [workStationId], references: [id])

  @@unique([workStationId, date])
  @@map("capacity_slots")
}
