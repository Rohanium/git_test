# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/joinery_erp?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://localhost:6379"

# File Storage (S3-compatible — MinIO for local dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="joinery-erp"
S3_REGION="us-east-1"

# Email (SMTP)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@joinery-erp.local"

# Accounting Integration (Xero example)
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Stripe (for online payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
