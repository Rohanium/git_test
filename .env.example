# ── Required for deployment ──────────────────────────────
# Database (use Neon free tier: https://neon.tech)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# NextAuth (generate secret: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here"
# NEXTAUTH_URL is auto-set on Vercel — only needed for local dev
# NEXTAUTH_URL="http://localhost:3000"

# ── Optional services ───────────────────────────────────
# Redis (not required for basic functionality)
# REDIS_URL="redis://localhost:6379"

# File Storage (S3-compatible)
# S3_ENDPOINT=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET="joinery-erp"
# S3_REGION="us-east-1"

# Email (SMTP)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noreply@joinery-erp.local"

# Stripe (for online payments)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PUBLISHABLE_KEY=""
